# ======================================================================
# Configuração — copie para ".env" e preencha.
# ======================================================================

# ---- Docker Compose ----
# Domínio público apontando para este servidor (HTTPS automático pelo Caddy).
# Rede interna sem domínio: use DOMINIO=:80 e COOKIE_SEGURO=false (veja deploy/Caddyfile).
DOMINIO=prefichas.seudominio.com.br

POSTGRES_DB=prefichas
POSTGRES_USER=prefichas
# Gere uma senha forte (só letras e números), por exemplo:  openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha

# ---- Aplicação ----
# Sem Docker, informe a conexão completa com o PostgreSQL:
# DATABASE_URL=postgres://prefichas:SENHA@localhost:5432/prefichas

# Cookies apenas em HTTPS (deixe true em produção)
COOKIE_SEGURO=true
# Horas de inatividade até o login expirar
SESSAO_HORAS=12
# Máximo de pré-fichas enviadas por hora a partir do mesmo IP
# (aumente em eventos em que muitas pessoas usam o mesmo Wi-Fi)
LIMITE_ENVIOS_POR_HORA=30

# ---- Site (aplicado ao gerar o site: docker compose up --build / npm run build) ----
# WhatsApp exibido no rodapé do formulário
VITE_WHATSAPP_CONTATO=5548996954410
