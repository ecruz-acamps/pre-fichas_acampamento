# ======================================================================
# Configuração de UMA instalação (um acampamento).
# Dica: ./scripts/novo-acampamento.sh gera este arquivo automaticamente.
# ======================================================================

# Nome desta instalação no Docker (use um diferente para cada acampamento no mesmo servidor)
COMPOSE_PROJECT_NAME=prefichas-meu-acampamento

# Identidade aplicada na PRIMEIRA inicialização (depois, ajuste pelo painel → Configurações)
NOME_ACAMPAMENTO=Nome do Acampamento
# (avançado) arquivo de marca completo — veja marcas/modelo.json
MARCA_INICIAL=

# ---- HTTPS ----
# "caddy" = este acampamento tem o próprio proxy HTTPS (servidor com um só acampamento).
# Deixe vazio quando vários acampamentos dividem o servidor (veja deploy/Caddyfile.multi).
COMPOSE_PROFILES=caddy
# Domínio público apontando para este servidor (HTTPS automático pelo Caddy).
# Rede interna sem domínio: DOMINIO=:80 e COOKIE_SEGURO=false.
DOMINIO=prefichas.seudominio.com.br
# Endereço público completo (usado na prévia do link no WhatsApp)
URL_PUBLICA=https://prefichas.seudominio.com.br
# Porta local da aplicação (127.0.0.1). Mude se houver vários acampamentos: 3001, 3002...
PORTA_LOCAL=3000
# Portas públicas do Caddy (troque se 80/443 já estiverem em uso)
PORTA_HTTP=80
PORTA_HTTPS=443

# ---- Banco de dados ----
POSTGRES_DB=prefichas
POSTGRES_USER=prefichas
# Gere uma senha forte (só letras e números):  openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha
# Sem Docker, informe a conexão completa:
# DATABASE_URL=postgres://prefichas:SENHA@localhost:5432/prefichas

# ---- Aplicação ----
# Cookies apenas em HTTPS (deixe true em produção)
COOKIE_SEGURO=true
# Horas de inatividade até o login expirar
SESSAO_HORAS=12
# Máximo de pré-fichas enviadas por hora a partir do mesmo IP
# (aumente em eventos em que muitas pessoas usam o mesmo Wi-Fi)
LIMITE_ENVIOS_POR_HORA=30
# Mesmo telefone ou e-mail: máximo de pré-fichas em 24 h
LIMITE_ENVIOS_POR_CONTATO_DIA=3
# Todos os envios somados por hora (proteção contra ataque de muitos IPs)
LIMITE_ENVIOS_GLOBAL_HORA=300
# Login: senhas erradas seguidas que bloqueiam a conta (qualquer IP) e por quantos minutos
LOGIN_MAX_FALHAS_CONTA=8
LOGIN_BLOQUEIO_MINUTOS=15

# ---- Contas dos participantes ----
# true = a página inicial pede login (CPF ou e-mail + senha) e a inscrição exige conta
CONTA_OBRIGATORIA=true

# ---- E-mail (recuperação de senha e criação de senha das contas importadas) ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORTA=465, usuário = o e-mail, senha = "senha de app"
# (myaccount.google.com → Segurança → Senhas de app). Outros: Brevo, Zoho, servidor próprio.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORTA=465
# SMTP_USUARIO=inscricoes@seuacampamento.com.br
# SMTP_SENHA=
# SMTP_REMETENTE=inscricoes@seuacampamento.com.br

# ---- CAPTCHA no formulário (opcional, Cloudflare Turnstile — gratuito) ----
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# ---- Login com a Microsoft (opcional, Microsoft Entra ID) ----
# Normalmente gravado pelo painel central da VM (Instâncias → Login Microsoft). Só preencha à mão se não usar o painel central.
# MICROSOFT_HABILITADO=true
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ---- Aviso de atualização ----
# O painel avisa o administrador quando há uma versão nova no GitHub.
ATUALIZACAO_VERIFICAR=true
ATUALIZACAO_REPO=ecruz-acamps/pre-fichas_acampamento
ATUALIZACAO_BRANCH=main
# Só se o repositório se tornar privado: token de leitura do GitHub
# ATUALIZACAO_TOKEN=
