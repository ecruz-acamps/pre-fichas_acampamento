# ======================================================================
# Configuração de UMA instalação (um acampamento).
# Dica: ./scripts/novo-acampamento.sh gera este arquivo automaticamente.
# ======================================================================

# Nome desta instalação no Docker (use um diferente para cada acampamento no mesmo servidor)
COMPOSE_PROJECT_NAME=prefichas-sao-padre-pio

# Identidade aplicada na PRIMEIRA inicialização (depois, ajuste pelo painel → Configurações)
MARCA_INICIAL=marcas/sao-padre-pio.json

# ---- HTTPS ----
# "caddy" = este acampamento tem o próprio proxy HTTPS (servidor com um só acampamento).
# Deixe vazio quando vários acampamentos dividem o servidor (veja deploy/Caddyfile.multi).
COMPOSE_PROFILES=caddy
# Domínio público apontando para este servidor (HTTPS automático pelo Caddy).
# Rede interna sem domínio: DOMINIO=:80 e COOKIE_SEGURO=false.
DOMINIO=prefichas.seudominio.com.br
# Porta local da aplicação (127.0.0.1). Mude se houver vários acampamentos: 3001, 3002...
PORTA_LOCAL=3000

# ---- Banco de dados ----
POSTGRES_DB=prefichas
POSTGRES_USER=prefichas
# Gere uma senha forte (só letras e números):  openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha
# Sem Docker, informe a conexão completa:
# DATABASE_URL=postgres://prefichas:SENHA@localhost:5432/prefichas

# ---- Aplicação ----
# Cookies apenas em HTTPS (deixe true em produção)
COOKIE_SEGURO=true
# Horas de inatividade até o login expirar
SESSAO_HORAS=12
# Máximo de pré-fichas enviadas por hora a partir do mesmo IP
# (aumente em eventos em que muitas pessoas usam o mesmo Wi-Fi)
LIMITE_ENVIOS_POR_HORA=30
