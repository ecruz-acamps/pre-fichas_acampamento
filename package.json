    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.4.5"
  },
